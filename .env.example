APP_NAME="Kilat Print"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Target production database: MySQL 8+ / MariaDB 10.6+
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kilat_print
DB_USERNAME=root
DB_PASSWORD=

# For a zero-config local fallback, change DB_CONNECTION to sqlite.
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@kilatprint.test"
MAIL_FROM_NAME="${APP_NAME}"

# Label bank fallback untuk data pembayaran lama. Pembayaran baru memakai
# virtual account dari Midtrans, jadi nomor rekening statis tidak dipakai.
BANK_NAME="Bank Digital Demo"
# Tarif pengiriman dalam rupiah. Isi dengan tarif nyata sebelum produksi;
# checkout akan gagal jelas jika kosong. Set DELIVERY_FREE=true hanya bila
# pengiriman gratis memang kebijakan bisnis.
DELIVERY_FEE=10000
DELIVERY_FREE=false
DESIGN_MAX_KILOBYTES=10240

# --- Payment gateway -------------------------------------------------------
# Every transaction is settled by the provider: the customer pays by QRIS or by
# bank transfer to a virtual account, and the order is marked paid only after the
# provider confirms it. Keep the server key out of version control.
#
#   driver   : midtrans | null  (`null` refuses to create transactions)
#   sandbox  : true routes every call to api.sandbox.midtrans.com
#
# Never paste the server key into chat, source control, Blade, or JavaScript.
# Store it locally with a hidden prompt:
#   php artisan payments:key
#
# In the Midtrans dashboard set the Payment Notification URL to:
#   https://<your-public-domain>/payments/webhook/midtrans
# localhost cannot receive Midtrans callbacks; use an HTTPS tunnel or staging.
PAYMENT_PROVIDER=midtrans
PAYMENT_SERVER_KEY=
PAYMENT_CLIENT_KEY=
PAYMENT_MERCHANT_ID=
PAYMENT_SANDBOX=true
PAYMENT_EXPIRY_HOURS=24
# Midtrans Core API acquiring bank: bca | bni | bri | permata | cimb
PAYMENT_BANK_TRANSFER_BANK=bca
PAYMENT_CURRENCY=IDR

PAYMENT_MAX_KILOBYTES=5120
CUSTOM_DESIGN_MAX_KILOBYTES=5120
CUSTOM_DESIGN_ASSET_MAX_KILOBYTES=5120
CUSTOM_DESIGN_ASSET_DISK=local
CUSTOM_DESIGN_ASSETS_PER_DRAFT=50

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
